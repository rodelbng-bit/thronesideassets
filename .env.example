# GoHighLevel Private Integration token (Contacts: write scope)
# Settings → Business Profile → API Keys → Private Integrations
GHL_API_KEY=

# GoHighLevel Location ID
# Settings → Business Profile
GHL_LOCATION_ID=

# Postgres connection string (Vercel dashboard → Storage → Create Database → Postgres)
DATABASE_URL=

# Auth.js session signing secret — generate with `npx auth secret`
AUTH_SECRET=

# GoCardless — Developers → Create → Access Token
GOCARDLESS_ACCESS_TOKEN=
# GoCardless — Developers → Webhook endpoints → your endpoint → secret
GOCARDLESS_WEBHOOK_SECRET=
# GoCardless environment — "sandbox" or "live"
GOCARDLESS_ENVIRONMENT=sandbox

# Resend — resend.com/api-keys
RESEND_API_KEY=
# Verified sending address/domain in Resend
RESEND_FROM_EMAIL=

# Base URL used to build links in emails (no trailing slash)
SITE_URL=https://www.thronesideassets.com

# Comma-separated list of emails allowed to access /admin/deals/new
ADMIN_EMAILS=

# Vercel Blob — Vercel dashboard → Storage → Create Database → Blob
# (auto-injected once the store is connected to the project)
BLOB_READ_WRITE_TOKEN=

# SerpApi — serpapi.com/manage-api-key. Powers Theme Room's cheapest-price
# lookups (Google Shopping engine).
SERPAPI_API_KEY=

# Replicate — replicate.com/account/api-tokens. Powers Theme Room's
# photo-to-redesign image generation.
REPLICATE_API_TOKEN=

# Anthropic — console.anthropic.com/settings/keys. Optional: only used as a
# fallback in Theme Room to suggest shoppable items when a member's
# redesign style doesn't match one of the curated categories. Redesigns
# still work without it, just without a fallback item list.
ANTHROPIC_API_KEY=
